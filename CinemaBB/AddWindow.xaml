<Window x:Class="CinemaBB.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaBB"
        mc:Ignorable="d"
        Title="Добавитьпользователя" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
            <RowDefinition Height="10" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Фамилия:"/>
        <TextBox x:Name="SurNameTb" Grid.Row="0" Grid.Column="2" 
                 Text="{Binding SurName}"/>

        <TextBlock Grid.Row="2" Text="Имя:" />
        <TextBox x:Name="NameTb" Grid.Row="2" Grid.Column="2"
                  Text="{Binding Name}"/>

        <TextBlock Grid.Row="4" Text="Логин:"/>
        <TextBox x:Name="LoginTb" Grid.Row="4" Grid.Column="2"
                 Text="{Binding Login}"/>

        <TextBlock Grid.Row="6" Text="Пароль:"/>
        <TextBox x:Name="PasswordTb" Grid.Row="6" Grid.Column="2"
                 Text="{Binding Password}"/>

        <TextBlock Grid.Row="8" Text="почта:"/>
        <TextBox x:Name="emailTb" Grid.Row="8" Grid.Column="2"
                                  Text="{Binding email}"/>
        <!--ff-->
        <!--аа-->

        <Button x:Name="AddUserBtn" Grid.Row="12" Grid.Column="2"
                 Click="AddUserBtn_Click" Content="Добавить компанию"/>
    </Grid>

</Window>

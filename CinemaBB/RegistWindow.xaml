<Window x:Class="CinemaBB.RegistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaBB"
        mc:Ignorable="d"
        Title="RegistWindow" Height="900" Width="800">
    <Window.Resources>
        <!-- Кинематографическая цветовая схема -->
        <SolidColorBrush x:Key="CinemaDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CinemaRed" Color="#E50914"/>
        <SolidColorBrush x:Key="CinemaGold" Color="#F5C518"/>
        <SolidColorBrush x:Key="CinemaGray" Color="#2D2D3A"/>
        <SolidColorBrush x:Key="CinemaWhite" Color="#FFFFFF"/>

        <Style x:Key="CinemaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CinemaButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
        </Style>

        <Style x:Key="CinemaTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CinemaGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="CinemaPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource CinemaGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер -->
    <Border CornerRadius="12" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#16213E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="{StaticResource CinemaRed}" CornerRadius="12,12,0,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="22" Margin="0,0,10,0"/>
                        <TextBlock Text="КИНОТЕАТР" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CinemaWhite}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Регистрация администратора" 
                               Foreground="{StaticResource CinemaWhite}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="25">
                <StackPanel>
                    <!-- Иконка -->
                    <Border Width="70" Height="70" Background="{StaticResource CinemaRed}" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="🎫" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Создание учётной записи" 
                               Foreground="{StaticResource CinemaGold}" 
                               FontWeight="Bold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Имя -->
                    <TextBlock Text="Имя" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTb" Style="{StaticResource CinemaTextBoxStyle}" Text=""/>

                    <!-- Фамилия -->
                    <TextBlock Text="Фамилия" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,15,0,5"/>
                    <TextBox x:Name="SurNameTb" Style="{StaticResource CinemaTextBoxStyle}" Text=""/>

                    <!-- Логин -->
                    <TextBlock Text="Логин" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,15,0,5"/>
                    <TextBox x:Name="LoginTb" Style="{StaticResource CinemaTextBoxStyle}" Text=""/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,15,0,5"/>
                    <PasswordBox Name="PasswordPb" Style="{StaticResource CinemaPasswordBoxStyle}"/>

                    <!-- Подтверждение пароля (добавим для удобства, но можно убрать) -->
                    <TextBlock Text="Подтверждение пароля" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="PasswordAccessPb" Style="{StaticResource CinemaPasswordBoxStyle}"/>

                    <!-- Почта (необязательно) -->
                    <TextBlock Text="Почта (необязательно)" Foreground="{StaticResource CinemaWhite}" FontSize="12" Margin="0,15,0,5"/>
                    <TextBox x:Name="emailTb" Style="{StaticResource CinemaTextBoxStyle}" Text=""/>

                    <!-- Индикатор ошибки пароля (для демонстрации) -->


                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                        <Button Content="ЗАРЕГИСТРИРОВАТЬ" Style="{StaticResource CinemaButtonStyle}"
                                Width="150" Margin="0,0,15,0"
                                Name="RegBtn" Click="RegBtn_Click_1" Cursor="Hand"/>
                        <Button Content="НАЗАД" Style="{StaticResource SecondaryButtonStyle}" Width="100" />

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource CinemaRed}" CornerRadius="0,0,12,12" Padding="12">
                <TextBlock Text="© 2025 КИНОТЕАТР • Административная система" 
                           Foreground="{StaticResource CinemaWhite}" 
                           TextAlignment="Center"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</Window>
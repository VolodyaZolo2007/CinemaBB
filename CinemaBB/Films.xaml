<Window x:Class="CinemaBB.Films"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaBB"
        mc:Ignorable="d"
        Title="Films" Height="450" Width="800">
    <!-- Views/MoviesWindow.xaml -->


    <Window.Resources>
        <!-- Цветовая схема кинотеатра (повтор из предыдущих окон) -->
        <SolidColorBrush x:Key="CinemaDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CinemaRed" Color="#E50914"/>
        <SolidColorBrush x:Key="CinemaGold" Color="#F5C518"/>
        <SolidColorBrush x:Key="CinemaGray" Color="#2D2D3A"/>
        <SolidColorBrush x:Key="CinemaLightGray" Color="#3A3A4A"/>
        <SolidColorBrush x:Key="CinemaWhite" Color="#FFFFFF"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MovieCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CinemaGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#16213E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="{StaticResource CinemaRed}" CornerRadius="12,12,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="22" Margin="0,0,10,0"/>
                        <TextBlock Text="КИНОТЕАТР" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CinemaWhite}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Управление фильмами" 
                               Foreground="{StaticResource CinemaWhite}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Панель поиска и добавления -->
            <Border Grid.Row="1" Background="{StaticResource CinemaDark}" Padding="15" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CinemaGold}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="14" Foreground="{StaticResource CinemaWhite}" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Width="250" Height="32" 
                                 Background="{StaticResource CinemaGray}" 
                                 BorderBrush="{StaticResource CinemaGold}" 
                                 BorderThickness="1"
                                 Foreground="{StaticResource CinemaWhite}"
                                 Padding="8,5"
                                 FontSize="12"
                                  TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <Button Grid.Column="1" Name="AddFilmBtn" Click="AddFilmBtn_Click" Content="+ Добавить фильм" Style="{StaticResource ActionButtonStyle}" Height="32" Padding="15,5"/>
                </Grid>
            </Border>

            <!-- Список фильмов в карточках -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="10">
                <ListBox x:Name="FilmLb">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MovieCardStyle}">
                                <StackPanel>
                                    <Border Height="140" Background="{StaticResource CinemaLightGray}" CornerRadius="6" Margin="0,0,0,10">
                                        <TextBlock Text="🎞️" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource CinemaGold}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource CinemaGold}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding genre}" Foreground="{StaticResource CinemaWhite}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding time}" Foreground="{StaticResource CinemaWhite}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding age}" Foreground="{StaticResource CinemaWhite}" FontSize="11" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️ Редактировать" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0" Padding="8,3"/>
                                        <Button x:Name="RemoveBtn" Click="RemoveBtn_Click" Content="🗑️ Удалить" Style="{StaticResource SecondaryButtonStyle}" Background="Transparent" BorderBrush="{StaticResource CinemaRed}" Foreground="{StaticResource CinemaRed}" Padding="8,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- Футер -->
            <Border Grid.Row="3" Background="{StaticResource CinemaRed}" CornerRadius="0,0,12,12" Padding="10">
                <TextBlock Text="© 2025 КИНОТЕАТР • Администрирование фильмов" 
                           Foreground="{StaticResource CinemaWhite}" 
                           TextAlignment="Center"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</Window>
<Window x:Class="CinemaBB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaBB"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1080">
    <Window.Resources>
        <!-- Цветовая схема кинотеатра -->
        <SolidColorBrush x:Key="CinemaRed" Color="#B81C1C"/>
        <SolidColorBrush x:Key="CinemaGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="CinemaDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CinemaDarkGray" Color="#2C2C3A"/>
        <SolidColorBrush x:Key="CinemaLight" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="CinemaWhite" Color="White"/>
        <SolidColorBrush x:Key="CinemaBlack" Color="#0A0A0F"/>

        <!-- Стили -->
        <Style x:Key="TheaterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="30"
                                BorderThickness="1"
                                BorderBrush="{StaticResource CinemaGold}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9E1616"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TheaterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CinemaDarkGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="CaretBrush" Value="{StaticResource CinemaGold}"/>
        </Style>

        <Style x:Key="TheaterPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource CinemaDarkGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="CaretBrush" Value="{StaticResource CinemaGold}"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="30" Height="30" Background="Transparent">
                            <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaGold}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="14" Margin="0,0,5,0"/>
                            <ContentPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Основной контейнер с фоном -->
    <Border CornerRadius="20" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0F1C" Offset="0"/>
                <GradientStop Color="#1A1A2E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя полоса с кнопкой закрытия -->
            <Border Grid.Row="0" Height="40" Background="Transparent">
                <Button Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right" Margin="0,10,15,0"/>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="30,0,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть: Декорация кинотеатра -->
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel>
                        <!-- Иконка кинопленки -->
                        <TextBlock Text="🎬" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="КИНОТЕАТР" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource CinemaGold}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Административная панель" 
                                   FontSize="14" 
                                   Foreground="{StaticResource CinemaLight}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- Декоративные элементы: кинолента -->

                    </StackPanel>

                </Border>

                <!-- Правая часть: форма авторизации -->
                <Border Grid.Column="1" Background="#25253A" CornerRadius="15" Padding="30" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Вход в систему" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource CinemaWhite}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Логин администратора" 
                                   Foreground="{StaticResource CinemaLight}" 
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource TheaterTextBoxStyle}" 
                                 Text="admin"
                                 Name="LoginTb"/>

                        <TextBlock Text="Пароль" 
                                   Foreground="{StaticResource CinemaLight}" 
                                   FontSize="12"
                                   Margin="0,15,0,5"/>
                        <PasswordBox x:Name="PasswordPb" Style="{StaticResource TheaterPasswordBoxStyle}"/>

                        <CheckBox Content="Запомнить меня" 
                                  Foreground="{StaticResource CinemaLight}"
                                  Margin="0,15,0,0"
                                  FontSize="11"/>

                        <!-- Кнопка входа -->
                        <Button Content="ВОЙТИ В СИСТЕМУ" Name="EnterBtn" Click="EnterBtn_Click"
                                Style="{StaticResource TheaterButtonStyle}"
                                Height="45"
                                FontSize="13"
                                Margin="0,30,0,10"/>
                        <Button Content="Регистраци" 
        Style="{StaticResource TheaterButtonStyle}"
        Height="45"
        FontSize="13"
        Margin="0,30,0,10"
                                Name="RegBtn" Click="RegBtn_Click"/>

                        <!-- Дополнительная информация -->
                        

                        <Border Height="1" Background="{StaticResource CinemaDarkGray}" Margin="0,20,0,15"/>

                        <TextBlock Text="© КИНОТЕАТР • Система управления" 
                                   Foreground="#888888"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
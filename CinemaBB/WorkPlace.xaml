<Window x:Class="CinemaBB.WorkPlace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaBB"
        mc:Ignorable="d"
        Title="WorkPlace" Height="450" Width="800">
    <Window.Resources>
        <!-- Кинематографическая цветовая схема -->
        <SolidColorBrush x:Key="CinemaDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CinemaRed" Color="#E50914"/>
        <SolidColorBrush x:Key="CinemaGold" Color="#F5C518"/>
        <SolidColorBrush x:Key="CinemaGray" Color="#2D2D3A"/>
        <SolidColorBrush x:Key="CinemaLightGray" Color="#3A3A4A"/>
        <SolidColorBrush x:Key="CinemaWhite" Color="#FFFFFF"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CinemaRed}"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!--пва-->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CinemaGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CinemaGold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource CinemaWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#16213E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="{StaticResource CinemaRed}" CornerRadius="12,12,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="22" Margin="0,0,10,0"/>
                        <TextBlock Text="КИНОТЕАТР" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CinemaWhite}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Административная панель" 
                               Foreground="{StaticResource CinemaWhite}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Основная область -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковое меню -->
                <Border Grid.Column="0" Background="{StaticResource CinemaDark}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="МЕНЮ" Foreground="{StaticResource CinemaGold}" FontWeight="Bold" FontSize="14" Margin="10,10,10,20"/>
                        <Button Content="👥 Пользователи" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5"/>
                        <Button Content="🎬 Фильмы" Name="FilmBtn" Click="FilmBtn_Click" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5"/>
                        <Button Content="💰 Штрафы" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5"/>
                        <Button Content="⚙️ Настройки" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5"/>
                        <Button Content="🚪 Выход" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Stretch" Margin="0,5"/>
                    </StackPanel>
                </Border>

                <!-- Контентная область: список пользователей -->

                <Grid Grid.Column="1" Background="{StaticResource CinemaLightGray}" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель с кнопкой добавления -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CinemaGold}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Список пользователей" Foreground="{StaticResource CinemaGold}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchTb" Grid.Column="1"   FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Name="AddBtn" Click="AddBtn_Click" Content="+ Добавить Пользователя" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" FontSize="12"/>
                            <Button x:Name="SearchBtn" Click="SearchBtn_Click" Grid.Column="2" Content="Поиск" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,6" FontSize="12" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Карточки пользователей -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ListBox Name="UsersLb" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SurName}" Foreground="{StaticResource CinemaWhite}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Name}" Padding="5 0 0 0" Foreground="{StaticResource CinemaWhite}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Login}" Foreground="{StaticResource CinemaWhite}" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Role.Name}" Foreground="{StaticResource CinemaGold}" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding email}" Foreground="{StaticResource CinemaWhite}" FontSize="11" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="✏️ Редактировать" Style="{StaticResource ActionButtonStyle}" Width="100" Margin="0,0,5,0"/>
                                                <Button x:Name="RemoveBtn" Click="RemoveBtn_Click" Content="🗑️ Удалить" Style="{StaticResource ActionButtonStyle}" Background="#555" Width="80"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Карточка 1 -->
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Футер -->
            <Border Grid.Row="2"
                    Background="{StaticResource CinemaRed}" 
                    CornerRadius="0,0,12,12" Padding="10">

                <TextBlock Text="© 2025 КИНОТЕАТР • Административная система" 
                           Foreground="{StaticResource CinemaWhite}" 
                           TextAlignment="Center"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</Window>